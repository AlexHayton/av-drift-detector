{
  "name": "av-drift-detector",
  "version": "0.2.0",
  "description": "Measure audio/video sync to a fraction of a millisecond, frame by frame (Node.js bindings)",
  "keywords": [
    "av-sync",
    "lipsync",
    "audio",
    "video",
    "ffmpeg",
    "latency"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexHayton/av-drift-detector.git",
    "directory": "bindings/node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "napi": {
    "binaryName": "av-drift-detector",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test",
    "prepublishOnly": "napi pre-publish -t npm --no-gh-release",
    "artifacts": "napi artifacts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8"
  }
}
